# RSS Remastered Environment Configuration
# Copy to .env and fill in values
# Environment variables override YAML config which overrides defaults

# =============================================================================
# Core Configuration
# =============================================================================

# Database URL (async SQLAlchemy format)
# RSS_DATABASE_URL=sqlite+aiosqlite:///data/rss.db

# Base URL for reverse proxy support (leave empty for direct access)
# RSS_BASE_URL=https://rss.example.com

# Data directory for persistent storage
# RSS_DATA_DIR=data

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: debug, info, warning, error
# RSS_LOG_LEVEL=info

# Log format: json (production), console (development)
# RSS_LOG_FORMAT=json

# =============================================================================
# AI Provider Configuration
# =============================================================================

# AI provider: openai (OpenAI-compatible), ollama (local), none (disabled)
# RSS_AI__PROVIDER=none

# Base URL for AI provider API
# RSS_AI__BASE_URL=http://localhost:11434  # Ollama
# RSS_AI__BASE_URL=https://api.openai.com/v1  # OpenAI

# AI model name
# RSS_AI__MODEL=llama3.2  # Ollama
# RSS_AI__MODEL=gpt-4  # OpenAI

# API key for AI provider (KEEP SECRET)
# RSS_AI__API_KEY=sk-...

# =============================================================================
# Development/Debug
# =============================================================================

# Enable debug mode (adds error details to responses)
# DEBUG=false

# =============================================================================
# Test Environment Configuration
# =============================================================================

# Test environment indicator
TEST_ENV=local

# Application URLs for testing
BASE_URL=http://localhost:8080
API_URL=http://localhost:8080/api
